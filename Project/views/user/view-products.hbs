<section>
    <div class="container mt-5">
        <div class="row">
            {{#each products}}
            <div class="col-sm-6 col-md-4 col-lg-3 p-3">
                <div class="card h-100">
                    <img class="card-img-top" src="/product-images/{{this._id}}.jpg" alt="{{this.Name}}"
                        style="height: 10rem; object-fit: cover;">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">{{this.Name}}</h5>
                        <p class="card-text text-muted small">{{this.Description}}</p>
                        <p class="card-text font-weight-bold mt-auto">{{money this.Price}}</p>
                        <form action="/cart/add/{{this._id}}" method="post">
                            <button type="submit" class="btn btn-primary btn-block">Add to Cart</button>
                        </form>
                    </div>
                </div>
            </div>
            {{else}}
            <p class="col text-center text-muted">No products yet.</p>
            {{/each}}
        </div>
    </div>
</section>
