<section>
    <div class="container mt-5">
        <h3>My Orders</h3>
        {{#if orders.length}}
        <table class="table mt-4">
            <thead>
                <tr>
                    <th scope="col">Date</th>
                    <th scope="col">Items</th>
                    <th scope="col">Total</th>
                    <th scope="col">Status</th>
                    <th scope="col"></th>
                </tr>
            </thead>
            <tbody>
                {{#each orders}}
                <tr>
                    <td>{{date this.date}}</td>
                    <td>{{this.products.length}}</td>
                    <td>{{money this.totalAmount}}</td>
                    <td><span class="badge badge-{{statusClass this.status}} text-capitalize">{{this.status}}</span></td>
                    <td><a href="/orders/{{this._id}}" class="btn btn-sm btn-outline-primary">View</a></td>
                </tr>
                {{/each}}
            </tbody>
        </table>
        {{else}}
        <p class="mt-4">You haven't placed any orders yet. <a href="/">Start shopping</a></p>
        {{/if}}
    </div>
</section>
